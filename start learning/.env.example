# Copy to .env and fill in. .env is gitignored — never commit real tokens.

# Same provider used throughout the LangChain course
HUGGINGFACEHUB_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional — LangSmith tracing. Very useful in LangGraph for seeing each
# node execution and state transition in a run.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_xxxxxxxxxxxxxxxxxxxxxxxx
# LANGSMITH_PROJECT=langgraph-course
